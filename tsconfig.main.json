{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@shared/*": ["./src/shared/*"] },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"]
}
