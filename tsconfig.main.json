{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@pdf/*": ["./src/pdf/*"],
      "@conversion/*": ["./src/conversion/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    // The engines that write files run in the main process, which owns the
    // files they write. The render engine stays renderer-only.
    "src/pdf/mutate/**/*.ts",
    "src/pdf/create/**/*.ts",
    "src/pdf/text/**/*.ts",
    "src/conversion/**/*.ts"
  ]
}
