{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@pdf/*": ["./src/pdf/*"],
      "@conversion/*": ["./src/conversion/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/pdf/**/*.ts",
    "src/shared/**/*.ts"
  ],
  // Security parsing runs in the main process and uses Node's crypto.
  "exclude": ["src/pdf/security/**/*.ts"]
}
